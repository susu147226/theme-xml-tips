  "完整锁屏模板（unlock/xml/theme）": {
    "prefix": ["unlock", "xml", "theme"],
    "body": [
      "<?xml version=\"1.0\" encoding=\"UTF-8\"?>",
      "<Lockscreen version=\"1\" frameRate=\"60\" vibrate=\"false\" screenWidth=\"1080\" displayDeskTop=\"true\">",
      "    <Var name=\"w\" expression=\"#screen_width\" persist=\"true\" const=\"true\" />",
      "    <Var name=\"h\" expression=\"#screen_height\" persist=\"true\" const=\"true\" />",
      "",
      "    <Var name=\"click\" expression=\"le(abs(#touch_x-#touch_begin_x),50)*le(abs(#touch_y-#touch_begin_y),50)\" />",
      "    <Var name=\"pai\" expression=\"3.1415926535898\" persist=\"true\" const=\"true\" />",
      "",
      "    <!-- 居中裁剪 -->",
      "    <Var name=\"cen_h\" expression=\"#h/2-1320\" />",
      "    <!-- 底部裁剪 -->",
      "    <Var name=\"bot_h\" expression=\"#h-2640\" />",
      "",
      "    <!-- 位移量：swipeDY 向上为正，swipeDX 向右为正 -->",
      "    <Var name=\"swipeDX\" expression=\"#touch_x-#touch_begin_x\" />",
      "    <Var name=\"swipeDY\" expression=\"#touch_begin_y-#touch_y\" />",
      "",
      "    <!-- 上滑：纵向位移>200，且大于横向偏移的绝对值 -->",
      "    <Var name=\"upSlide\" expression=\"gt(#swipeDY,200)*gt(#swipeDY,abs(#swipeDX))\" />",
      "    <!-- 下滑 -->",
      "    <Var name=\"downSlide\" expression=\"lt(#swipeDY,-200)*lt(#swipeDY,-1*abs(#swipeDX))\" />",
      "    <!-- 左滑 -->",
      "    <Var name=\"leftSlide\" expression=\"lt(#swipeDX,-200)*lt(#swipeDX,-1*abs(#swipeDY))\" />",
      "    <!-- 右滑 -->",
      "    <Var name=\"rightSlide\" expression=\"gt(#swipeDX,200)*gt(#swipeDX,abs(#swipeDY))\" />",
      "",
      "    <Var expression=\"1\" name=\"notification\" />",
      "",
      "    <!-- OPPO乐滑 【其他平台需注释掉本段】 -->",
      "    <SupportPictorialButton w=\"1080\" h=\"#screen_height\">",
      "        <Triggers>",
      "            <Trigger action=\"up\">",
      "                <IntentCommand action=\"com.heytap.pictorial.action.START_PICTURE_MODE\" category=\"android.intent.category.DEFAULT\" package=\"com.heytap.pictorial\" class=\"com.heytap.pictorial.ui.slide.PictorialSlideActivity\" condition=\"gt(#touch_begin_x-#touch_x,250)\" />",
      "            </Trigger>",
      "        </Triggers>",
      "    </SupportPictorialButton>",
      "",
      "    <!-- 线性变换动画 -->",
      "    <Var name=\"loop\">",
      "        <VariableAnimation>",
      "            <AniFrame value=\"5000\" time=\"0\" />",
      "            <AniFrame value=\"9999999\" time=\"9999999\" />",
      "        </VariableAnimation>",
      "    </Var>",
      "",
      "    <!-- 开屏动画 -->",
      "    <Var name=\"kpdt\">",
      "        <VariableAnimation>",
      "            <AniFrame value=\"1\" time=\"0\" varSpeedFlag=\"QuartFun_Out\" />",
      "            <AniFrame value=\"0\" time=\"1200\" />",
      "            <AniFrame value=\"0\" time=\"99999999\" />",
      "        </VariableAnimation>",
      "    </Var>",
      "",
      "    <!-- 开屏透明度动画 -->",
      "    <Var name=\"kpal\">",
      "        <VariableAnimation>",
      "            <AniFrame value=\"0\" time=\"0\" />",
      "            <AniFrame value=\"255\" time=\"1200\" />",
      "            <AniFrame value=\"255\" time=\"99999999\" />",
      "        </VariableAnimation>",
      "    </Var>",
      "",
      "    <!-- 开屏命令 -->",
      "    <ExternalCommands>",
      "        <Trigger action=\"resume\">",
      "            <Command target=\"loop.animation\" value=\"stop\"/>",
      "            <Command target=\"loop.animation\" value=\"play\"/>",
      "",
      "            <Command target=\"kpdt.animation\" value=\"stop\"/>",
      "            <Command target=\"kpdt.animation\" value=\"play\"/>",
      "            <Command target=\"kpal.animation\" value=\"stop\"/>",
      "            <Command target=\"kpal.animation\" value=\"play\"/>",
      "",
      "            <VariableCommand name=\"xq1\" expression=\"#day_of_week-1\" />",
      "            <VariableCommand name=\"xq\" expression=\"#day_of_week\" />",
      "            <VariableCommand name=\"rq\" expression=\"#date\" />",
      "            <VariableCommand name=\"yue\" expression=\"#month\" />",
      "            <VariableCommand name=\"nian\" expression=\"#year\" />",
      "",
      "",
      "        </Trigger>",
      "        <Trigger action=\"pause\">",
      "",
      "        </Trigger>",
      "",
      "    </ExternalCommands>",
      "",
      "",
      "    <!-- 全局btn -->",
      "    <Button w=\"#w\" h=\"#h\">",
      "        <Triggers>",
      "            <Trigger action=\"down\">",
      "                <VariableCommand name=\"slider_flag\" expression=\"0\" />",
      "                <!-- <VariableCommand name=\"move_xq_start2\" expression=\"1\" /> -->",
      "            </Trigger>",
      "            <Trigger action=\"up\">",
      "                <VariableCommand name=\"time_cdjm\" expression=\"#loop\" condition=\"#cdjm\" />",
      "                <!-- 解锁 -->",
      "                <ExternCommand command=\"unlock\" condition=\"#upSlide\" />",
      "",
      "",
      "                <!-- 切换版式 -->",
      "",
      "",
      "                <VariableCommand name=\"slider_flag\" expression=\"ifelse(#touch_x-#touch_begin_x-150,1,#touch_begin_x-#touch_x-200,2,0)\" />",
      "            </Trigger>",
      "        </Triggers>",
      "    </Button>",
      "",
      "    <!-- 视图层 -->",
      "    <!-- OPPO 【其他平台需注释掉本行】 -->",
      "    <Wallpaper src=\"wallpaper.jpg\" />",
      "    <!-- 华为 -->",
      "    <Image scaleType=\"center_crop\" isBackground=\"true\" src=\"bj.png\" />",
      "",
      "    <Image src=\"top.png\" />",
      "$0",
      "</Lockscreen>"
    ],
    "description": "完整锁屏模板：滑动方向判断 + 开屏动画 + 解锁命令（唤醒词 unlock / xml / theme）"
  },

