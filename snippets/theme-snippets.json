  "常用写法 01 · Var 自定义变量": {
    "prefix": "var",
    "body": "<Var name=\"${1:name}\" expression=\"${2:expression}\" persist=\"${3:true}\" const=\"${4:true}\" />",
    "description": "常用写法：自定义变量（规范 3.19）"
  },
  "常用写法 02 · Command 基础命令": {
    "prefix": "command",
    "body": "<Command target=\"${1:name.property}\" value=\"${2:value}\"/>",
    "description": "常用写法：基础命令（规范 3.25）"
  },
  "常用写法 03 · VariableCommand 变量命令": {
    "prefix": "var-command",
    "body": "<VariableCommand name=\"${1:name}\" expression=\"${2:expression}\" condition=\"${3:1}\" />",
    "description": "常用写法：变量命令（规范 3.30）"
  },
  "常用写法 04 · ExternCommand 解锁命令": {
    "prefix": "extern-unlock",
    "body": "<ExternCommand command=\"unlock\" condition=\"#${1:click}\" />",
    "description": "常用写法：解锁命令（规范 3.31 + 5.5 延时解锁）"
  },
  "常用写法 05 · Video 视频视图": {
    "prefix": "video-view",
    "body": "<Video name=\"${1:video}\" defaultBitmap=\"${2:default.png}\" src=\"${3:video.mp4}\" x=\"${4:0}\" y=\"${5:0}\" w=\"${6:#w}\" h=\"${7:#h}\" scaleType=\"${8|fill,center_crop,hold_center_crop|}\" play=\"${9:false}\" looping=\"${10:false}\" visibility=\"${11:1}\" />",
    "description": "常用写法：视频视图完整写法（规范 3.5）"
  },
  "常用写法 06 · Image 图片（缩放/全屏/可见性）": {
    "prefix": "image-view",
    "body": "<Image src=\"${1:image.png}\" x=\"${2:0}\" y=\"${3:0}\" w=\"${4:}\" h=\"${5:}\" scaleType=\"${6|fill,center_crop,hold_center_crop|}\" isFullScreenNode=\"${7:false}\" visibility=\"${8:1}\" />",
    "description": "常用写法：图片视图（规范 3.3）"
  },
  "常用写法 07 · Image 序列图（srcid）": {
    "prefix": "image-srcid",
    "body": "<Image src=\"${1:image.png}\" srcid=\"${2:#var}\" visibility=\"${3:1}\" />",
    "description": "常用写法：图片序列后缀，按变量显示不同图片（规范 3.3 srcid）"
  },
  "常用写法 08 · Image 图片源表达式（srcExp）": {
