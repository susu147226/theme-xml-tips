{
  "name": "theme-xml-tips",
  "displayName": "Theme XML Tips",
  "description": "主题引擎 XML 代码提示：标签/属性/枚举/变量补全、悬停文档与代码片段。适配 VS Code / WebStorm / HBuilderX / Sublime Text。作者：云舒眠眠。",
  "version": "2.2.6",
  "publisher": "susu147226",
  "author": {
    "name": "云舒眠眠"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "harmonyos",
    "theme",
    "xml",
    "lockscreen",
    "主题引擎",
    "鸿蒙"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:xml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "themeXmlTips.addSnippet",
        "title": "新增 XML 代码片段（Theme XML Tips）"
      },
      {
        "command": "themeXmlTips.manageSnippets",
        "title": "管理自定义代码片段（Theme XML Tips）"
      },
      {
        "command": "themeXmlTips.viewSnippets",
        "title": "查看自定义代码片段（Theme XML Tips）"
      },
      {
        "command": "themeXmlTips.importSnippets",
        "title": "导入自定义代码片段（Theme XML Tips）"
      },
      {
        "command": "themeXmlTips.exportSnippets",
        "title": "导出自定义代码片段（Theme XML Tips）"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "themeXmlTips.addSnippet",
          "when": "resourceLangId == xml",
          "group": "navigation@9"
        },
        {
          "command": "themeXmlTips.viewSnippets",
          "when": "resourceLangId == xml",
          "group": "navigation@9"
        }
      ]
    },
    "snippets": [
      {
        "language": "xml",
        "path": "./snippets/theme-snippets.json"
      }
    ],
    "configuration": {
      "title": "HarmonyOS Theme XML Tips",
      "properties": {
        "themeXmlTips.enableVariableCompletion": {
          "type": "boolean",
          "default": true,
          "description": "在属性值中输入 # 或 @ 时提示主题引擎全局变量"
        },
        "themeXmlTips.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "XML 错误检测：标签配对/未知标签/属性名/枚举取值/括号配对/srcExp 平台写法"
        },
        "themeXmlTips.customSnippets": {
          "type": "array",
          "default": [],
          "description": "自定义代码片段（也可在 XML 文件中右键 → 新增 XML 代码片段，用表格管理）。每项：{\"prefix\": \"唤醒词(必填)\", \"description\": \"描述(必填)\", \"body\": \"代码片段(xml格式，必填)\", \"platform\": \"平台(选填，不填为全平台)\"}",
          "items": {
            "type": "object",
            "properties": {
              "prefix": {
                "type": "string",
                "description": "唤醒词（必填）"
              },
              "description": {
                "type": "string",
                "description": "描述（必填）"
              },
              "body": {
                "type": "string",
                "description": "代码片段（xml格式，必填）"
              },
              "platform": {
                "type": "string",
                "enum": [
                  "",
                  "harmonyos",
                  "huawei",
                  "honor",
                  "oppo",
                  "vivo",
                  "xiaomi"
                ],
                "description": "平台（选填）：不填为全平台；填 harmonyos=鸿蒙 / huawei=华为 / honor=荣耀 / oppo / vivo / xiaomi=小米 后仅该平台提示"
              }
            },
            "required": [
              "prefix",
              "description",
              "body"
            ]
          }
        }
      }
    },
    "configurationDefaults": {
      "[xml]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "editor.wordBasedSuggestions": "off"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/susu147226/theme-xml-tips.git"
  }
}
